# 이 파일을 .env.local로 복사하고, 아래 한 줄의 토큰만 바꿔 주세요.
# API Key가 아니라 API Read Access Token을 사용해요. Bearer는 붙이지 않아요.
VITE_TMDB_API_BASE_URL=https://api.themoviedb.org/3
VITE_TMDB_ACCESS_TOKEN=여기에_API_Read_Access_Token을_붙여넣으세요

# 회원 API 서버 주소. 기존 로컬 NestJS 6주차 서버 사용 시 http://127.0.0.1:3004
VITE_API_BASE_URL=http://localhost:8080
